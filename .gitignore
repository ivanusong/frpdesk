# 构建产物
bin/
build/bin/
# 发布脚本生成的发布日志（来源为 annotated tag 描述，不入库）
release-notes.md

# 本地密钥与日志，绝不入库
*.key
*.pem
*.log

# wails3 生成的前端 bindings（构建时同步进 frontend/dist）
frontend/bindings/
frontend/dist/bindings/
frontend/dist/icon.svg

# 前端依赖（当前零构建链，预留）
node_modules/

# 工具缓存与系统文件
.task/
.DS_Store

# 编辑器
.idea/
.vscode/

# 服务端部署：本地密钥与证书，绝不入库
server/.env
server/letsencrypt/*
!server/letsencrypt/.gitkeep
