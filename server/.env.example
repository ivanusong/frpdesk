# Frpdesk server configuration. Copy this file to .env and fill in required values.
#   cp .env.example .env

# ---- Required ----

# Your base domain. Must match the domain of the wildcard DNS record you create.
# Frpdesk "Base domain" = this value. Services become <subdomain>.<FRPS_DOMAIN>.
FRPS_DOMAIN=example.com

# Secret shared with Frpdesk. Frpdesk "Auth token" = this value.
# Generate one with:  openssl rand -hex 32
FRPS_TOKEN=

# Email for Let's Encrypt renewal notices.
ACME_EMAIL=you@example.com

# DNS provider used for the DNS-01 challenge. Required for a wildcard certificate.
# Common values: alidns, dnspod, cloudflare. Full list:
#   https://go-acme.github.io/lego/dns/
DNS_PROVIDER=cloudflare

# ---- Required: the credential pair for your DNS provider ----
# Fill in only the one matching DNS_PROVIDER; uncomment it if needed.
# Scope it to this zone only; never use an account-wide key.

# cloudflare
CF_DNS_API_TOKEN=

# alidns (Alibaba Cloud)
# ALICLOUD_ACCESS_KEY=
# ALICLOUD_SECRET_KEY=

# dnspod
# DNSPOD_API_KEY=

# ---- Optional ----
# Defaults are shown below. Uncomment only when you need to change a value.

# Port for both the Frpdesk control connection and the HTTP tunnel entry.
# Frpdesk "Server port" = this value.
# FRPS_BIND_PORT=7000

# Ports that TCP/UDP services may occupy on the server.
# Frpdesk "Remote port" for a TCP/UDP service must be inside this range.
# FRPS_REMOTE_PORTS=20000-20099

# Seconds to wait for the DNS TXT record to propagate before Let's Encrypt checks it.
# Raise this if your DNS provider is slow.
# ACME_DELAY_BEFORE_CHECK=30
